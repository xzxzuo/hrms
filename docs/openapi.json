  "components": {
    "schemas": {
      "RoomStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "AVAILABLE|CLEANING|OUT_OF_SERVICE"
          }
        },
        "required": [
          "status"
        ]
      },
      "RoomType": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "bedType": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "capacity": {
            "type": "integer",
            "format": "int32",
            "maximum": 20,
            "minimum": 1
          },
          "basePrice": {
            "type": "number",
            "minimum": 0.01
          },
          "roomCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "pattern": "ACTIVE|INACTIVE"
          }
        },
        "required": [
          "basePrice",
          "bedType",
          "name",
          "status"
        ]
      },
      "Rate": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "price": {
            "type": "number",
            "minimum": 0.01
          }
        },
        "required": [
          "date",
          "price"
        ]
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "blocked": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "saleStatus": {
            "type": "string",
            "pattern": "OPEN|CLOSED"
          }
        },
        "required": [
          "date",
          "saleStatus"
        ]
      },
      "Hotel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "city": {
            "type": "string",
            "maxLength": 80,
            "minLength": 0
          },
          "address": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          },
          "timezone": {
            "type": "string",
            "minLength": 1
          },
          "facilities": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60,
              "minLength": 0
            },
            "uniqueItems": true
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 500,
              "minLength": 0
            }
          }
        },
        "required": [
          "address",
          "city",
          "facilities",
          "images",
          "name",
          "timezone"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "DRAFT|OPEN|CLOSED"
          }
        },
        "required": [
          "status"
        ]
      },
      "Quote": {
        "type": "object",
        "properties": {
          "roomTypeId": {
            "type": "integer",
            "format": "int64"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "quantity": {
            "type": "integer",
            "format": "int32",
            "maximum": 10,
            "minimum": 1
          }
        },
        "required": [
          "checkIn",
          "checkOut"
        ]
      },
      "Simulate": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int64"
          },
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{1,100}"
          },
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "providerRef"
        ]
      },
      "Callback": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int64"
          },
          "providerRef": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{1,100}"
          },
          "amount": {
            "type": "number",
            "minimum": 0
          },
          "success": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "amount",
          "providerRef"
        ]
      },
      "Create": {
        "type": "object",
        "properties": {
          "quoteId": {
            "type": "string",
            "maxLength": 36,
            "minLength": 0
          },
          "clientRequestId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{1,80}"
          },
          "couponId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "clientRequestId",
          "quoteId"
        ]
      },
      "Credentials": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 190,
            "minLength": 0
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 10
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PhysicalRoom": {
        "type": "object",
        "properties": {
          "roomNo": {
            "type": "string",
            "maxLength": 20,
            "minLength": 0
          },
          "status": {
            "type": "string",
            "pattern": "AVAILABLE|CLEANING|OUT_OF_SERVICE"
          }
        },
        "required": [
          "roomNo",
          "status"
        ]
      },
      "Coupon": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "discount": {
            "type": "number",
            "minimum": 0.01
          },
          "minTotal": {
            "type": "number",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "quota": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "discount",
          "expiresAt",
          "minTotal",
          "name"
        ]
      },
      "Campaign": {
        "type": "object",
        "properties": {
          "roomTypeId": {
            "type": "integer",
            "format": "int64"
          },
          "checkIn": {
            "type": "string",
            "format": "date"
          },
          "checkOut": {
            "type": "string",
            "format": "date"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "type": "number",
            "minimum": 0.01
          },
          "quota": {
            "type": "integer",
            "format": "int32",
            "maximum": 100000,
            "minimum": 1
          }
        },
        "required": [
          "checkIn",
          "checkOut",
          "endsAt",
          "price",
          "startsAt"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
